<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="com.cutefish.Display">
    <method name="GetOutputs">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;QVariantMap&gt;"/>
      <arg name="outputs" type="aa{sv}" direction="out"/>
    </method>
    <method name="SetMode">
      <arg name="name" type="s" direction="in"/>
      <arg name="width" type="i" direction="in"/>
      <arg name="height" type="i" direction="in"/>
    </method>
    <method name="SetScale">
      <arg name="name" type="s" direction="in"/>
      <arg name="scale" type="i" direction="in"/>
    </method>
    <method name="SetTransform">
      <arg name="name" type="s" direction="in"/>
      <arg name="transform" type="i" direction="in"/>
    </method>
    <signal name="OutputsChanged"/>
  </interface>
</node>
